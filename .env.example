# Local / Vercel — use the publishable or anon key in the browser. Never the secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...or_anon_jwt
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Vercel Production. Redeploy after saving.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...or_anon_jwt
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Do not add SUPABASE_SERVICE_ROLE_KEY or sb_secret_ to frontend env vars.
